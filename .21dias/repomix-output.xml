<file path="src/contexts/AppContext.tsx">
import React, { createContext, useContext, useEffect, useMemo, useState, type PropsWithChildren } from "react";
import { useColorScheme } from "react-native";
import { habits } from "../data/habits";
import type { DailyProgress, HabitId } from "../types/habits";

type ModoTema = "light" | "dark";
interface ValorContextoHabitos {
  modoOscuro: boolean;
  modoTema: ModoTema;
  alternarTema: () => void;
  progresoDiario: DailyProgress;
  alternarHabito: (id: HabitId) => void;
  reiniciarProgreso: () => void;
  habitosCompletados: number;
  porcentajeCompletado: number;
  diaActual: number;
  cambiarDia: (dia: number) => void;
}

const ContextoHabitos = createContext<ValorContextoHabitos | null>(null);
const progresoInicial = (): DailyProgress => ({ study: false, read: false, exercise: false, water: false });

export function AppProvider({ children }: PropsWithChildren) {
  const temaDelSistema = useColorScheme();
  const [modoTema, cambiarModoTema] = useState<ModoTema>("light");
  const [progresoDiario, actualizarProgreso] = useState<DailyProgress>(progresoInicial);
  const [diaActual, cambiarDiaActual] = useState(1);

  useEffect(() => {
    cambiarModoTema(temaDelSistema === "dark" ? "dark" : "light");
  }, [temaDelSistema]);

  const alternarHabito = (id: HabitId) => actualizarProgreso((progresoActual) => ({ ...progresoActual, [id]: !progresoActual[id] }));
  const reiniciarProgreso = () => actualizarProgreso(progresoInicial());
  const habitosCompletados = Object.values(progresoDiario).filter(Boolean).length;
  const porcentajeCompletado = Math.round((habitosCompletados / habits.length) * 100);

  const valor = useMemo<ValorContextoHabitos>(() => ({
    modoOscuro: modoTema === "dark",
    modoTema,
    alternarTema: () => cambiarModoTema((modoActual) => modoActual === "dark" ? "light" : "dark"),
    progresoDiario,
    alternarHabito,
    reiniciarProgreso,
    habitosCompletados,
    porcentajeCompletado,
    diaActual,
    cambiarDia: cambiarDiaActual,
  }), [modoTema, progresoDiario, habitosCompletados, porcentajeCompletado, diaActual]);

  return <ContextoHabitos.Provider value={valor}>{children}</ContextoHabitos.Provider>;
}

export function useHabitos(): ValorContextoHabitos {
  const contexto = useContext(ContextoHabitos);
  if (!contexto) throw new Error("useHabitos debe usarse dentro de AppProvider");
  return contexto;
}
</file>

